# Server Configuration
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/snippethub

# JWT Secrets (Replace with your own secure secrets)
ACCESS_TOKEN_SECRET=your-access-token-secret-here-make-it-long-and-secure
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here-make-it-different-and-secure
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary (for file uploads) - Get from https://cloudinary.com
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET_KEY=your-cloudinary-api-secret

# AI Integration (Groq) - Get from https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# Code Execution (Judge0 API) - Get from https://rapidapi.com/judge0-official/api/judge0-ce
RAPID_API_KEY_JUDGE0=your-judge0-api-key